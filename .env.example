# KYC Form Hub — Environment Configuration
#
# Copy this file to .env and adjust values for your deployment.
# All variables are optional; sensible localhost defaults are used when absent.

# Central orchestrator binding
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Public URL used in generated links/manifests (include the orchestrator port).
# Required when hosting behind a reverse proxy or on a remote machine.
PUBLIC_BASE_URL=http://localhost:3000

# CORS origin for API endpoints. Use a specific origin in production.
CORS_ORIGIN=*

# Trust proxy headers (enable when behind a reverse proxy).
TRUST_PROXY=false

# Request body size limit.
JSON_LIMIT=10mb

# Optional JSON file path for lightweight persistence of benchmark runs.
# Path can be absolute or relative to the project root. The parent directory must exist.
# BENCHMARK_STORAGE_PATH=benchmark-runs.json

# Per-stack server ports.
STACK_HTML_PORT=3010
STACK_REACT_PORT=3011
STACK_ANGULAR_PORT=3012
STACK_VUE_PORT=3013
STACK_PHP_PORT=3014
STACK_FLASK_PORT=3015

# URL stack servers use to call back to the central orchestrator.
CENTRAL_API_URL=http://localhost:3000
