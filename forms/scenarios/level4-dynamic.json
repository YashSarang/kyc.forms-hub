{
  "id": "level4-dynamic",
  "level": 4,
  "name": "Level 4 — Dynamic Conditional Logic & Cascading Rules",
  "description": "Tests dependent fields (spouse name on Married), cascading country/state/city, and live regex validation.",
  "stressFlags": {},
  "fields": [
    { "id": "full_name", "label": "Full Name", "type": "text", "required": true },
    { "id": "marital_status", "label": "Marital Status", "type": "select", "required": true, "options": ["Single", "Married", "Divorced", "Widowed"] },
    { "id": "spouse_name", "label": "Spouse Name", "type": "text", "required": true, "dependsOn": { "fieldId": "marital_status", "value": "Married" } },
    { "id": "curr_country", "label": "Country", "type": "select", "required": true, "options": ["India", "United States"] },
    { "id": "curr_state", "label": "State", "type": "select", "required": true, "cascadingFrom": "curr_country", "optionsMap": { "India": ["Maharashtra", "Karnataka", "Delhi"], "United States": ["California", "New York", "Texas"] } },
    { "id": "curr_city", "label": "City", "type": "select", "required": true, "cascadingFrom": "curr_state", "optionsMap": { "Maharashtra": ["Mumbai", "Pune"], "Karnataka": ["Bengaluru", "Mysuru"], "Delhi": ["New Delhi"], "California": ["Los Angeles", "San Francisco"], "New York": ["New York City"], "Texas": ["Houston", "Austin"] } },
    { "id": "pan_number", "label": "PAN Number", "type": "masked_input", "required": true, "validation": { "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "errorMessage": "Enter a valid PAN (e.g. ABCDE1234F)" } },
    { "id": "aadhaar_number", "label": "Aadhaar Number", "type": "masked_input", "required": true, "validation": { "pattern": "^[0-9]{12}$", "errorMessage": "Enter a 12-digit Aadhaar number" } }
  ],
  "groundTruth": {
    "full_name": "Rajesh Kumar Sharma",
    "marital_status": "Married",
    "spouse_name": "Priya Sharma",
    "curr_country": "India",
    "curr_state": "Maharashtra",
    "curr_city": "Mumbai",
    "pan_number": "ABCDE1234F",
    "aadhaar_number": "123456789012"
  }
}
